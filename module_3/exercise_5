print ("Enter the weight using medieval units:")
talents = float(input("Talents: "))
pounds = float(input("Pounds: "))
lots = float(input("Lots: "))
total_weight_in_grams = talents*20*32*13.3 + pounds*32*13.3 + lots*13.3
weight_in_kilograms = int(total_weight_in_grams / 1000)
remaining_grams = total_weight_in_grams % 1000
print(f"The weight in modern units is {weight_in_kilograms} kilograms and {remaining_grams} grams.")